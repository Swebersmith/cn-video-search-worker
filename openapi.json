    "/v1/tencent/series/{id}": {
      "get": {
        "summary": "腾讯视频指定作品目录与 AI 分集识别",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "apiKey": []
          },
          {}
        ],
        "description": "使用搜索返回的 detail_url。AI 仅选取已验证的官方候选，预告单列；缺少 Secret 或 AI 失败时使用规则处理并返回 ai 状态。",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 80
            },
            "description": "保留 detail_url 的原关键词。"
          }
        ],
        "responses": {
          "200": {
            "description": "目录，检查 complete、预告与 AI 状态",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Catalogue"
                }
              }
            }
          },
          "400": {
            "description": "无效 ID 或参数",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "认证失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "本次没有可用正片目录",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Catalogue"
                }
              }
            }
          }
        }
      }
    },
