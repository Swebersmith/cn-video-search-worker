{
  "openapi": "3.1.0",
  "info": {
    "title": "国内五大影视平台统一查询 API",
    "version": "1.3.1",
    "description": "两层查询：搜索返回各站剧集摘要，跟随 detail_url 获取所选作品的分集目录。五站均有目录适配，上游限制会标注不完整。仅返回官方播放页。"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    },
    "schemas": {
      "Video": {
        "type": "object",
        "required": [
          "platform",
          "platform_name",
          "title",
          "url",
          "kind",
          "score",
          "source"
        ],
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "tencent",
              "iqiyi",
              "youku",
              "mango",
              "bilibili"
            ]
          },
          "platform_name": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "官方网页播放地址，未经逐次可播放性验证。"
          },
          "kind": {
            "type": "string",
            "enum": [
              "video",
              "series"
            ]
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "source": {
            "type": "string",
            "enum": [
              "native",
              "brave"
            ]
          },
          "content_type": {
            "enum": [
              "search",
              "episode"
            ]
          },
          "episode_number": {
            "type": "integer"
          },
          "album_id": {
            "type": "string"
          },
          "series_title": {
            "type": "string"
          }
        }
      },
      "Series": {
        "type": "object",
        "required": [
          "platform",
          "id",
          "title",
          "detail_url",
          "content_type"
        ],
        "properties": {
          "platform": {
            "enum": [
              "tencent",
              "iqiyi",
              "youku",
              "mango",
              "bilibili"
            ]
          },
          "platform_name": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "year": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "series",
              "movie",
              "collection"
            ]
          },
          "type_name": {
            "type": "string"
          },
          "total_episodes": {
            "type": [
              "integer",
              "null"
            ],
            "description": "上游搜索标注条数，可能包含不同版本或附加内容。"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "detail_url": {
            "type": "string",
            "description": "当前服务的相对路径，保留 q 提示及准确剧集 ID；客户端应直接跟随此地址。"
          },
          "score": {
            "type": "number"
          },
          "content_type": {
            "const": "series"
          }
        }
      },
      "Catalogue": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "platform": {
            "enum": [
              "tencent",
              "iqiyi",
              "youku",
              "mango",
              "bilibili"
            ]
          },
          "series": {
            "$ref": "#/components/schemas/Series"
          },
          "total": {
            "type": "integer"
          },
          "main_total": {
            "type": "integer"
          },
          "extra_total": {
            "type": "integer"
          },
          "expected_total": {
            "type": [
              "integer",
              "null"
            ]
          },
          "complete": {
            "type": "boolean",
            "description": "与上游当前目录一致，不代表尚未发布的分集或播放权限。"
          },
          "partial": {
            "type": "boolean"
          },
          "missing_episode_numbers": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cached": {
            "type": "boolean"
          },
          "fetched_at": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "type": "string"
          },
          "took_ms": {
            "type": "integer"
          },
          "episodes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "platform": {
                  "enum": [
                    "tencent",
                    "iqiyi",
                    "youku",
                    "mango",
                    "bilibili"
                  ]
                },
                "episode_number": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "episode_type": {
                  "enum": [
                    "main",
                    "extra"
                  ]
                }
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "ok": {
            "const": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "SearchResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "query": {
            "type": "string"
          },
          "view": {
            "enum": [
              "series",
              "videos"
            ]
          },
          "mode": {
            "enum": [
              "all",
              "search",
              "episodes"
            ]
          },
          "partial": {
            "type": "boolean"
          },
          "total": {
            "type": "integer",
            "description": "本次返回的剧集摘要数（videos 模式为链接数）。"
          },
          "limit": {
            "type": "integer",
            "description": "每站剧集摘要或旧模式普通链接上限，不截断详情目录。"
          },
          "took_ms": {
            "type": "integer"
          },
          "results": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/Series"
                },
                {
                  "$ref": "#/components/schemas/Video"
                }
              ]
            }
          },
          "providers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "platform": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "ok",
                    "empty",
                    "degraded",
                    "unavailable",
                    "stale",
                    "unsupported"
                  ]
                },
                "count": {
                  "type": "integer"
                },
                "available_count": {
                  "type": "integer",
                  "description": "本次上游搜索中符合过滤规则的候选数，不是全剧总集数。"
                },
                "truncated": {
                  "type": "boolean",
                  "description": "是否被本次 limit 截断。"
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "cached": {
                  "type": "boolean"
                },
                "fetched_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "search_url": {
                  "type": "string",
                  "format": "uri"
                },
                "operations": {
                  "type": "object",
                  "properties": {
                    "search": {
                      "$ref": "#/components/schemas/Operation"
                    },
                    "episodes": {
                      "$ref": "#/components/schemas/Operation"
                    }
                  }
                },
                "catalog": {
                  "type": "object",
                  "properties": {
                    "series": {
                      "type": "object"
                    },
                    "series_candidates": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "total": {
                      "type": "integer"
                    },
                    "expected_total": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "complete": {
                      "type": "boolean"
                    },
                    "missing_episode_numbers": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    },
                    "warnings": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "cached": {
                      "type": "boolean"
                    },
                    "fetched_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "Operation": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "ok",
              "empty",
              "degraded",
              "unavailable",
              "stale",
              "unsupported",
              "skipped"
            ]
          },
          "count": {
            "type": "integer"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cached": {
            "type": "boolean"
          },
          "fetched_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "进程健康状态，不代表上游可用性",
        "responses": {
          "200": {
            "description": "Worker is running"
          }
        }
      }
    },
    "/v1/platforms": {
      "get": {
        "summary": "平台列表与标识",
        "responses": {
          "200": {
            "description": "Supported platforms"
          }
        }
      }
    },
    "/v1/episodes": {
      "get": {
        "deprecated": true,
        "summary": "获取爱奇艺电视剧的有序分集目录",
        "description": "先选择电视剧专辑，再读取官方目录。complete=true 表示目录集数与完整编号一致；不代表无需会员或每个页面均可播放。最多读取 500 集，不受 search 的 limit=5 限制。",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "apiKey": []
          },
          {}
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "example": "海市蜃楼"
          },
          {
            "name": "platform",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "iqiyi"
              ],
              "default": "iqiyi"
            }
          },
          {
            "name": "album_id",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^\\d{1,20}$"
            },
            "description": "可选：从该关键词匹配的 series_candidates 中选择专辑，避免同名电视剧混淆。"
          }
        ],
        "responses": {
          "200": {
            "description": "分集目录，需检查 complete 与 missing_episode_numbers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "query": {
                      "type": "string"
                    },
                    "platform": {
                      "const": "iqiyi"
                    },
                    "series": {
                      "type": "object",
                      "properties": {
                        "album_id": {
                          "type": "string"
                        },
                        "title": {
                          "type": "string"
                        },
                        "year": {
                          "type": "string"
                        },
                        "total_episodes": {
                          "type": [
                            "integer",
                            "null"
                          ]
                        }
                      }
                    },
                    "series_candidates": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "total": {
                      "type": "integer"
                    },
                    "expected_total": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "complete": {
                      "type": "boolean"
                    },
                    "partial": {
                      "type": "boolean"
                    },
                    "missing_episode_numbers": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "platform": {
                            "const": "iqiyi"
                          },
                          "platform_name": {
                            "type": "string"
                          },
                          "episode_number": {
                            "type": "integer"
                          },
                          "title": {
                            "type": "string"
                          },
                          "url": {
                            "type": "string",
                            "format": "uri"
                          },
                          "kind": {
                            "const": "video"
                          },
                          "source": {
                            "const": "native"
                          }
                        }
                      }
                    },
                    "warnings": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "cached": {
                      "type": "boolean"
                    },
                    "fetched_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "took_ms": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "参数错误或暂不支持此平台"
          },
          "401": {
            "description": "认证失败"
          },
          "404": {
            "description": "未匹配到电视剧专辑"
          },
          "503": {
            "description": "上游不可用或无可用分集"
          }
        }
      }
    },
    "/v1/search": {
      "get": {
        "summary": "聚合五站剧集列表，点击后读取目录",
        "description": "默认 view=series，results 是剧集摘要，通过 detail_url 获取特定版本的目录。view=videos 保留旧版扁平结果；显式 mode 参数隐式选择 videos。配置 API_KEY 后必须认证。partial=true 时检查 providers 状态。",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "apiKey": []
          },
          {}
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "example": "三体"
          },
          {
            "name": "view",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "series",
                "videos"
              ],
              "default": "series"
            }
          },
          {
            "name": "mode",
            "in": "query",
            "description": "兼容模式：仅 videos 使用。显式设置时隐式选择 videos；旧 episodes 仅爱奇艺，不用于新接入。",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "search",
                "episodes"
              ]
            }
          },
          {
            "name": "album_id",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^\\d{1,20}$"
            },
            "description": "爱奇艺专辑选择；仅 all/episodes 模式且选择包含 iqiyi 时可用。"
          },
          {
            "name": "platforms",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "all"
            },
            "description": "all 或 tencent,iqiyi,youku,mango,bilibili 的逗号分隔子集"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 5,
              "minimum": 1,
              "maximum": 20
            },
            "description": "每个平台剧集摘要上限；videos 模式为普通搜索上限。详情目录不受此限制。"
          }
        ],
        "responses": {
          "200": {
            "description": "查询完成，可能部分降级",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "认证失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "所选平台均未接入此功能",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "503": {
            "description": "所有所选平台不可用；请重试",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tencent/search": {
      "get": {
        "summary": "腾讯视频单站统一查询",
        "description": "先返回剧集列表，再按 detail_url 获取所选剧集的目录；上游限制和不完整目录会明确标注。 与聚合接口共用业务逻辑，只返回 tencent 的内容。",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "apiKey": []
          },
          {}
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "example": "三体"
          },
          {
            "name": "view",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "series",
                "videos"
              ],
              "default": "series"
            }
          },
          {
            "name": "mode",
            "in": "query",
            "description": "兼容模式：仅 videos 使用。显式设置时隐式选择 videos；旧 episodes 仅爱奇艺，不用于新接入。",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "search",
                "episodes"
              ]
            }
          },
          {
            "name": "album_id",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^\\d{1,20}$"
            },
            "description": "爱奇艺专辑选择；仅 all/episodes 模式且选择包含 iqiyi 时可用。"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 5,
              "minimum": 1,
              "maximum": 20
            },
            "description": "每个平台剧集摘要上限；videos 模式为普通搜索上限。详情目录不受此限制。"
          }
        ],
        "responses": {
          "200": {
            "description": "查询完成，可能部分降级",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "认证失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "所选平台均未接入此功能",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "503": {
            "description": "所有所选平台不可用；请重试",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/iqiyi/search": {
      "get": {
        "summary": "爱奇艺单站统一查询",
        "description": "先返回剧集列表，再按 detail_url 获取所选剧集的目录；上游限制和不完整目录会明确标注。 与聚合接口共用业务逻辑，只返回 iqiyi 的内容。",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "apiKey": []
          },
          {}
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "example": "三体"
          },
          {
            "name": "view",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "series",
                "videos"
              ],
              "default": "series"
            }
          },
          {
            "name": "mode",
            "in": "query",
            "description": "兼容模式：仅 videos 使用。显式设置时隐式选择 videos；旧 episodes 仅爱奇艺，不用于新接入。",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "search",
                "episodes"
              ]
            }
          },
          {
            "name": "album_id",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^\\d{1,20}$"
            },
