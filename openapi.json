        "security": [
          {
            "bearerAuth": []
          },
          {
            "apiKey": []
          },
          {}
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "搜索摘要的原始 id，各平台格式不同。"
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 80
            },
            "description": "保留 detail_url 中的发现关键词。优酷冷缓存读取需要此值。"
          }
        ],
        "responses": {
          "200": {
            "description": "目录可能不完整，必须检查 complete",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Catalogue"
                }
              }
            }
          },
          "400": {
            "description": "参数或剧集 ID 错误"
          },
          "401": {
            "description": "认证失败"
          },
          "503": {
            "description": "上游本次未返回可用目录",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Catalogue"
                }
              }
            }
          }
        }
      }
    },
