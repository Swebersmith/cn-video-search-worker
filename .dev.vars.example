# 可选访问密钥；留空则公开。所有站点只调用该站官网，不需要第三方搜索密钥。
API_KEY=""
# AI：本地开发时填自己的密钥；生产使用 Cloudflare Secret。不要提交真实密钥。
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-flash"
AI_TIMEOUT_MS="18000"

# TMDB 服务端凭据，任选一种；优先使用 Read Access Token。生产使用 Cloudflare Secrets。
TMDB_READ_ACCESS_TOKEN=""
TMDB_API_KEY=""
TMDB_ENABLED="on"
TMDB_TIMEOUT_MS="5000"

# 采集站管理：独立密钥，至少 12 字符，建议使用 32 字符以上随机值。生产使用 Cloudflare Secret。
RESOURCE_ADMIN_KEY=""
