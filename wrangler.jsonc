{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cn-video-search",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "videosearch.webber.qzz.io", "custom_domain": true }
  ],
  "kv_namespaces": [
    { "binding": "RESOURCE_CONFIG", "id": "2b538796038d4a77bfc2872c03394323" }
  ],
  "vars": {
    "CORS_ORIGIN": "*",
    "CACHE_TTL_SECONDS": "300",
    "UPSTREAM_TIMEOUT_MS": "10000",
    "DEEPSEEK_MODEL": "deepseek-flash",
    "AI_TIMEOUT_MS": "18000"
  },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
