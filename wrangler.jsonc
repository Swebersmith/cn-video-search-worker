{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cn-video-search",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "videosearch.webber.qzz.io", "custom_domain": true }
  ],
  "vars": {
    "BILIBILI_GATEWAY_URL": "https://bili-origin.webber.qzz.io",
    "CORS_ORIGIN": "*",
    "CACHE_TTL_SECONDS": "300",
    "UPSTREAM_TIMEOUT_MS": "10000",
    "DEEPSEEK_MODEL": "deepseek-flash",
    "AI_TIMEOUT_MS": "18000"
  },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
